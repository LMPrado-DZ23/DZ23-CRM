<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="dz23_ai_res_config_settings_view" model="ir.ui.view">
        <field name="name">dz23.ai.res.config.settings</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="DZ23 IA" name="dz23_ai">
                    <block title="Provedor de IA (padrão global)"
                           help="Local (Ollama) é grátis e sem custo de token. Groq e Gemini têm free-tier. Chaves ficam no servidor.">
                        <setting string="Provedor e modelo">
                            <div class="content-group">
                                <field name="dz23_ai_provider"/>
                                <field name="dz23_ai_model" placeholder="ex.: llama3.1 / gpt-4o-mini"/>
                            </div>
                        </setting>
                        <setting string="Local grátis (Ollama)"
                                 help="Rode 'ollama serve' na máquina; sem custo de token.">
                            <field name="dz23_ai_ollama_base"/>
                        </setting>
                        <setting string="Privacidade — IA externa (LGPD)"
                                 help="Provedores externos só funcionam com consentimento. Dados saem por allowlist e com PII redigida. Local (Ollama) nunca é bloqueado.">
                            <field name="dz23_ai_external_allowed"/>
                        </setting>
                        <setting string="Chaves de API (opcional)">
                            <div class="content-group">
                                <field name="dz23_ai_groq_key" password="True" placeholder="Groq (free-tier)"/>
                                <field name="dz23_ai_google_key" password="True" placeholder="Google Gemini (free-tier)"/>
                                <field name="dz23_ai_openai_key" password="True" placeholder="OpenAI (pago)"/>
                                <field name="dz23_ai_anthropic_key" password="True" placeholder="Anthropic (pago)"/>
                            </div>
                        </setting>
                    </block>
                    <block title="IA desta empresa"
                           help="Sobrescreve o padrão global para a empresa atual: provedor, consentimento e limites de uso.">
                        <setting string="Provedor e modelo da empresa">
                            <div class="content-group">
                                <field name="dz23_company_ai_provider"/>
                                <field name="dz23_company_ai_model"/>
                            </div>
                        </setting>
                        <setting string="IA externa nesta empresa">
                            <field name="dz23_company_ai_external_policy"/>
                        </setting>
                        <setting string="Limites de uso" help="0 = sem limite. Ao atingir, o atendimento segue sem IA.">
                            <div class="content-group">
                                <field name="dz23_company_ai_daily_call_limit"/>
                                <field name="dz23_company_ai_monthly_cost_limit_usd"/>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
