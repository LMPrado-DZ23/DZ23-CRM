<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="cron_dz23_media_download" model="ir.cron">
        <field name="name">DZ23: baixar mídias recebidas</field>
        <field name="model_id" ref="model_dz23_message_media"/>
        <field name="state">code</field>
        <field name="code">model._cron_process()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>

    <record id="cron_dz23_media_retention" model="ir.cron">
        <field name="name">DZ23: retenção de mídias (remove arquivos vencidos)</field>
        <field name="model_id" ref="model_dz23_message_media"/>
        <field name="state">code</field>
        <field name="code">model._cron_purge_expired()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
