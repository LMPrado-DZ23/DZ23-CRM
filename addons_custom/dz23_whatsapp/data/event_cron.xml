<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Fila status_event (ADR-008): reaplica à outbox eventos de status que foram
         persistidos pelo webhook mas não puderam ser aplicados na hora. -->
    <record id="cron_dz23_event_apply_pending" model="ir.cron">
        <field name="name">DZ23: reaplicar eventos de status pendentes</field>
        <field name="model_id" ref="model_dz23_message_event"/>
        <field name="state">code</field>
        <field name="code">model._cron_apply_pending()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
