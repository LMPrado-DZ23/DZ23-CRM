<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Trilha das ações de negócio idempotentes (ADR-005): somente leitura. -->
    <record id="dz23_business_action_view_list" model="ir.ui.view">
        <field name="name">dz23.business.action.list</field>
        <field name="model">dz23.business.action</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false"
                  decoration-danger="state == 'failed'" decoration-muted="state == 'cancelled'">
                <field name="create_date"/>
                <field name="company_id"/>
                <field name="channel_id"/>
                <field name="action_type"/>
                <field name="state"/>
                <field name="target_model"/>
                <field name="target_res_id"/>
                <field name="source_correlation_id" optional="hide"/>
                <field name="idempotency_key" optional="hide"/>
                <field name="completed_at"/>
            </list>
        </field>
    </record>

    <record id="dz23_business_action_view_form" model="ir.ui.view">
        <field name="name">dz23.business.action.form</field>
        <field name="model">dz23.business.action</field>
        <field name="arch" type="xml">
            <form create="false" edit="false" delete="false">
                <sheet>
                    <group>
                        <group>
                            <field name="action_type"/>
                            <field name="state"/>
                            <field name="company_id"/>
                            <field name="channel_id"/>
                            <field name="idempotency_key"/>
                        </group>
                        <group>
                            <field name="target_model"/>
                            <field name="target_res_id"/>
                            <field name="source_correlation_id"/>
                            <field name="source_inbox_id"/>
                            <field name="completed_at"/>
                            <field name="error"/>
                        </group>
                    </group>
                    <field name="result_payload"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="dz23_business_action_view_search" model="ir.ui.view">
        <field name="name">dz23.business.action.search</field>
        <field name="model">dz23.business.action</field>
        <field name="arch" type="xml">
            <search>
                <field name="idempotency_key"/>
                <field name="source_correlation_id"/>
                <field name="channel_id"/>
                <filter name="quotes" string="Orçamentos" domain="[('action_type', '=', 'quote')]"/>
                <filter name="schedules" string="Agendamentos"
                        domain="[('action_type', 'in', ('schedule', 'reschedule', 'cancel_schedule'))]"/>
                <group>
                    <filter name="group_type" string="Tipo" context="{'group_by': 'action_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="dz23_business_action_action" model="ir.actions.act_window">
        <field name="name">Ações de negócio</field>
        <field name="res_model">dz23.business.action</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="dz23_business_action_menu" name="Ações de negócio"
              parent="dz23_channel_menu_root" action="dz23_business_action_action"
              sequence="40" groups="base.group_system"/>
</odoo>
