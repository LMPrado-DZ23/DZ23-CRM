<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Isolamento multi-tenant: cada usuário só vê canais da(s) sua(s) empresa(s). -->
    <record id="dz23_channel_company_rule" model="ir.rule">
        <field name="name">dz23.channel: por empresa</field>
        <field name="model_id" ref="model_dz23_channel"/>
        <field name="domain_force">[('company_id','in',company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

    <record id="dz23_channel_contact_company_rule" model="ir.rule">
        <field name="name">dz23.channel.contact: por empresa</field>
        <field name="model_id" ref="model_dz23_channel_contact"/>
        <field name="domain_force">[('company_id','in',company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

    <record id="dz23_message_inbox_company_rule" model="ir.rule">
        <field name="name">dz23.message.inbox: por empresa</field>
        <field name="model_id" ref="model_dz23_message_inbox"/>
        <field name="domain_force">[('company_id','in',company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

    <record id="dz23_message_event_company_rule" model="ir.rule">
        <field name="name">dz23.message.event: por empresa</field>
        <field name="model_id" ref="model_dz23_message_event"/>
        <field name="domain_force">[('company_id','in',company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

    <record id="dz23_message_outbox_company_rule" model="ir.rule">
        <field name="name">dz23.message.outbox: por empresa</field>
        <field name="model_id" ref="model_dz23_message_outbox"/>
        <field name="domain_force">[('company_id','in',company_ids)]</field>
        <field name="global" eval="True"/>
    </record>
</odoo>
