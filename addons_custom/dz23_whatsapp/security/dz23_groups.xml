<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Grupos da caixa de atendimento (ADR-010). -->
    <record id="res_groups_privilege_dz23_attendance" model="res.groups.privilege">
        <field name="name">DZ23 Atendimento</field>
        <field name="sequence">60</field>
    </record>

    <record id="group_dz23_attendant" model="res.groups">
        <field name="name">Atendente</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_dz23_attendance"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Atende as conversas de WhatsApp da(s) própria(s) empresa(s).</field>
    </record>

    <record id="group_dz23_supervisor" model="res.groups">
        <field name="name">Supervisor</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_dz23_attendance"/>
        <field name="implied_ids" eval="[(4, ref('group_dz23_attendant'))]"/>
        <field name="comment">Atendente que também pode excluir conversas.</field>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
