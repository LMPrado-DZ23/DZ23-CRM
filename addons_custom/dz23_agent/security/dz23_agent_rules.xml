<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Isolamento multi-tenant da fila de IA (contém texto do cliente). -->
    <record id="dz23_ai_request_company_rule" model="ir.rule">
        <field name="name">dz23.ai.request: por empresa</field>
        <field name="model_id" ref="model_dz23_ai_request"/>
        <field name="domain_force">[('company_id','in',company_ids)]</field>
        <field name="global" eval="True"/>
    </record>
</odoo>
