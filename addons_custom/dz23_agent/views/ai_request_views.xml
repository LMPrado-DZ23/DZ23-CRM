<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="dz23_ai_request_view_list" model="ir.ui.view">
        <field name="name">dz23.ai.request.list</field>
        <field name="model">dz23.ai.request</field>
        <field name="arch" type="xml">
            <list create="false" decoration-warning="status == 'failed'"
                  decoration-info="status == 'processing'" decoration-muted="status == 'done'">
                <field name="create_date"/>
                <field name="company_id"/>
                <field name="channel_id"/>
                <field name="lead_id"/>
                <field name="status"/>
                <field name="used_fallback"/>
                <field name="attempts"/>
                <field name="provider"/>
                <field name="model_name"/>
                <field name="duration_ms" optional="hide"/>
                <field name="error" optional="show"/>
            </list>
        </field>
    </record>

    <record id="dz23_ai_request_view_form" model="ir.ui.view">
        <field name="name">dz23.ai.request.form</field>
        <field name="model">dz23.ai.request</field>
        <field name="arch" type="xml">
            <form create="false">
                <header>
                    <field name="status" widget="statusbar" statusbar_visible="pending,processing,done"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="company_id"/>
                            <field name="channel_id"/>
                            <field name="lead_id"/>
                            <field name="correlation_id"/>
                        </group>
                        <group>
                            <field name="attempts"/>
                            <field name="max_attempts"/>
                            <field name="next_attempt_at"/>
                            <field name="used_fallback"/>
                            <field name="provider"/>
                            <field name="model_name"/>
                            <field name="prompt_version"/>
                            <field name="duration_ms"/>
                        </group>
                    </group>
                    <field name="error"/>
                    <notebook>
                        <page string="Mensagem">
                            <field name="prompt_text"/>
                        </page>
                        <page string="Resposta">
                            <field name="response_text"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="dz23_ai_request_action" model="ir.actions.act_window">
        <field name="name">Fila de IA</field>
        <field name="res_model">dz23.ai.request</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="dz23_ai_request_menu" name="Fila de IA"
              parent="dz23_whatsapp.dz23_channel_menu_root" action="dz23_ai_request_action"
              sequence="45" groups="base.group_system"/>
</odoo>
